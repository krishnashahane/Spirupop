# SpiruPop environment template
# Public checkout/payment requires NO secrets and NO database credentials.
# Add optional values below only for extra features.

# Optional: canonical public origin used for metadata/absolute URLs.
# Defaults to https://spirupop.com
# SITE_ORIGIN=https://spirupop.com

# Optional: PostgreSQL/Neon connection for the /admin order dashboard.
# Checkout itself does NOT require this.
# DATABASE_URL=
# POSTGRES_URL=

# Optional: admin authentication for /admin.
# ADMIN_PASSWORD=
# ADMIN_SECRET=

# Optional: order notification inbox.
# ORDER_ALERT_EMAIL=spiruhomeglobalsolutions@gmail.com

# Optional: Meta WhatsApp Cloud API order alerts.
# WHATSAPP_TO=917972452200
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
