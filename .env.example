# SpiruPop production environment
# Copy to your hosting provider's environment settings.
# NEVER commit a real .env file or secret values.

# Required for order persistence and /api/order
DATABASE_URL=
# Alternative supported variable name:
# POSTGRES_URL=

# Required for /admin authentication
ADMIN_PASSWORD=

# Backward-compatible alternative to ADMIN_PASSWORD
# ADMIN_SECRET=

# Canonical public site origin.
# For the client deployment use:
# SITE_ORIGIN=https://spirupop.com
# For www use:
# SITE_ORIGIN=https://www.spirupop.com
SITE_ORIGIN=https://spirupop.com

# Optional order-alert email recipient
# Default: spiruhomeglobalsolutions@gmail.com
ORDER_ALERT_EMAIL=

# Optional Meta WhatsApp Cloud API order alerts
# WHATSAPP_TO=917972452200
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
